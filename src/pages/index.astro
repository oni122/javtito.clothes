---
import '../styles/global.css';
import Layout from '../components/Layout.astro';
import CommerceDashboard from '../components/CommerceDashboard';
---

<Layout title="Javito's Clothes · Ecommerce">
  <main class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-10 sm:px-6 lg:px-8">
    <header class="card-surface relative overflow-hidden">
      <div class="grid gap-8 lg:grid-cols-[1.1fr,0.9fr]">
        <div class="p-8 lg:p-10">
          <div class="flex items-center justify-between text-sm text-gray-600">
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-green-500"></span>En línea</span>
            <a class="underline decoration-cocoa decoration-2 underline-offset-4" href="https://instagram.com" target="_blank">
              @javito.clothes
            </a>
          </div>
          <h1 class="mt-4 font-display text-4xl leading-tight text-ink sm:text-5xl">
            Javito's Clothes
          </h1>
          <p class="mt-3 text-lg text-gray-600">
            Conjuntos, enteritos y vestidos listos para envío. Administra el stock en vivo y activa la colección sin perder visibilidad de la bodega.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="button-primary" href="#tienda">Ir a la tienda</a>
            <a class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-3 text-sm font-semibold text-cocoa shadow-sm" href="#admin">
              Panel de administración →
            </a>
          </div>
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl bg-white/80 px-4 py-3 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cocoa">Despacho</p>
              <p class="text-sm text-gray-700">Envíos a Chile y retiro en Santiago.</p>
            </div>
            <div class="rounded-2xl bg-white/80 px-4 py-3 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cocoa">Pagos</p>
              <p class="text-sm text-gray-700">Webpay, Mercado Pago y transferencias.</p>
            </div>
            <div class="rounded-2xl bg-white/80 px-4 py-3 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cocoa">Stock en vivo</p>
              <p class="text-sm text-gray-700">Descuenta al vender, recarga desde bodega.</p>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="absolute inset-0 rounded-l-[48px] bg-gradient-to-br from-blush/80 via-white to-sand/70"></div>
          <div class="relative grid h-full grid-cols-2 gap-3 p-6">
            <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=800&q=80" alt="Conjunto" class="h-full w-full rounded-3xl object-cover shadow-xl" loading="lazy" />
            <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80" alt="Vestido" class="h-full w-full rounded-3xl object-cover shadow-xl" loading="lazy" />
            <img src="https://images.unsplash.com/photo-1496747611180-206a5c8c46b2?auto=format&fit=crop&w=800&q=80" alt="Conjunto" class="h-full w-full rounded-3xl object-cover shadow-xl" loading="lazy" />
            <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80&sat=-20" alt="Vestido" class="h-full w-full rounded-3xl object-cover shadow-xl" loading="lazy" />
          </div>
        </div>
      </div>
    </header>

    <div id="tienda" class="flex flex-col gap-6">
      <CommerceDashboard client:load />
    </div>

    <footer id="admin" class="mb-10 grid gap-4 rounded-3xl bg-ink px-6 py-8 text-white sm:grid-cols-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sand">Contacto</p>
        <p class="text-lg font-semibold">Javito's Clothes</p>
        <p class="text-sm text-sand">Whatsapp +56 9 612345678</p>
        <p class="text-sm text-sand">tucorreo@example.com</p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sand">Redes</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <span class="rounded-full bg-white/10 px-3 py-1 text-xs">Instagram</span>
          <span class="rounded-full bg-white/10 px-3 py-1 text-xs">TikTok</span>
          <span class="rounded-full bg-white/10 px-3 py-1 text-xs">Pinterest</span>
          <span class="rounded-full bg-white/10 px-3 py-1 text-xs">Facebook</span>
        </div>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sand">Métodos de pago</p>
        <div class="mt-3 grid grid-cols-2 gap-2 text-xs font-semibold text-ink">
          <span class="rounded-xl bg-white px-3 py-2 text-center">Webpay</span>
          <span class="rounded-xl bg-white px-3 py-2 text-center">Mercado Pago</span>
          <span class="rounded-xl bg-white px-3 py-2 text-center">Transferencia</span>
          <span class="rounded-xl bg-white px-3 py-2 text-center">Efectivo</span>
        </div>
      </div>
    </footer>
  </main>
</Layout>
